# Generated by the pipeline
__pycache__/
*.py[cod]
*.so

# Table outputs; figure outputs land in figures/ and overwrite the shipped copies
results/
/*.png
/*.tex
re-organized/*.png
re-organized_mls/*.png
paper_revise/

# Run logs written beside the scripts. The three Mantel logs in logs/ are shipped
# because 43_09 pins the Section IV-G p-values to them.
*.log
!logs/*.log

# Extraction artefacts (never committed: hundreds of GB)
inferred/
audios/
models/
huggingface/
*.npy
*.wav

# Environment
geometry_env/
.venv/
venv/

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp

# The Praat measurement folders (910 MB) and the archive that carries them. Both are distributed as a
# release asset; see supplementary/README.md.
scripts/praat_PitchTier/
scripts/praat_PitchTier_mls/
supplementary/scripts_full.zip
