# Generated by the pipeline
__pycache__/
*.py[cod]
*.so

# Table outputs; figure outputs land in figures/ and overwrite the shipped copies
results/
/*.png
/*.tex
re-organized/*.png
re-organized_mls/*.png
paper_revise/

# Run logs written beside the scripts. The three Mantel logs in logs/ are shipped
# because 43_09 pins the Section IV-G p-values to them.
*.log
!logs/*.log

# Extraction artefacts (never committed: hundreds of GB)
inferred/
audios/
models/
huggingface/
*.npy
*.wav

# Environment
geometry_env/
.venv/
venv/

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp

# Praat binaries; the runbook in praat_PitchTier/ works with any Praat 6.4.x
*.exe

# Case-study inputs: the two small arrays ship with the repository; the 108 MB recording
# is stored with Git LFS in the deployment repository only, so it stays out of this one.
!scripts/_hn_rucheng_dim1815_frames1000_2000.npy
!scripts/praat_f0_aligned_20s_40s.npy
# The Rucheng recording ships here through Git LFS
!scripts/hn_rucheng_1_hours_merged.wav
